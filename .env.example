# Proveedor por defecto: "gemini" (gratis con free tier) o "claude" (de pago).
AI_PROVIDER=gemini

# Gemini (Google AI Studio)
# Consigue tu key en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-pega-aqui-tu-key-de-google
GEMINI_MODEL=gemini-2.0-flash

# Claude (Anthropic) — opcional, solo si AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-api03-xxx
CLAUDE_MODEL=claude-sonnet-4-5
